    "eslint-plugin-vue": "^10.9.2",
    "gh-pages": "^6.3.0",
    "globals": "^17.7.0",
    "less": "^4.6.7",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.64.0",
